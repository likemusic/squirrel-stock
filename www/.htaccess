AddDefaultCharset utf-8
DirectoryIndex index.php

#php_value error_reporting 5
 
RewriteEngine on
RewriteBase / 

# SquirrelStock: служебные файлы не отдаются браузеру (списки библиотек и их версий, словари, консольные скрипты, примеры)
RewriteRule ^(composer\.(json|lock)|script_examples\.zip|init\.php|[^/]*\.md)$ - [F,L]
RewriteRule ^(lang|cli)(/|$) - [F,L]
# из vendor/ — только статика, которую подключают страницы (css, js, картинки, шрифты)
RewriteCond %{REQUEST_URI} !\.(css|js|png|gif|jpe?g|svg|ico|woff2?|ttf|eot|map)$ [NC]
RewriteRule ^vendor/ - [F,L]
# из upload/ — только картинки (jpg, png, gif, webp; svg — нет: в нем может быть скрипт) и без «.php.» и подобного в имени:
# хостинг с AddHandler выполнил бы x.php.png. Правило здесь, а не только в upload/.htaccess: папку upload/ тома Docker
# и установка Linux создают пустой, а восстановление из копии пишет в нее файлы
RewriteRule ^upload/(?!.*\.(php\d*|pht|phtml|phar|cgi|pl|py|sh|shtml|htaccess)(\.|/|$))[^?]*\.(jpe?g|png|gif|webp)$ - [NC,L]
RewriteRule ^upload(/|$) - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
 
RewriteRule ^(\/index\.php.{0,}|[-#a-zA-Z0-9\/_]+)$ /index.php [L,QSA]

# SquirrelStock: заголовки безопасности (нужен mod_headers; HSTS включайте только после перехода сайта на HTTPS)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always unset X-Powered-By
    Header unset X-Powered-By
    # Content-Security-Policy: загружать и отправлять — только на свой адрес, встраивать — только в свои фреймы.
    # 'unsafe-inline' и 'unsafe-eval' нужны фреймворку (onclick в ссылках, ответы AJAX выполняются через eval), шрифт data: — иконки FullCalendar в zippy-bundle.css.
    # Магазин (модуль shop, вне профиля благотворительной организации) — без политики: платежные виджеты с чужих адресов.
    <If "%{THE_REQUEST} !~ m#^\S+\s+/(shop|sp|pcat|scat|blog|menu|cchat)(/|\?|\s)|Modules/Shop/#">
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    </If>
</IfModule>
